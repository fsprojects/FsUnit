<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>FsUnit.MsTest</AssemblyName>
    <PackageId>Fs30Unit.MsTest</PackageId>
    <Description>FsUnit is a set of extensions that add special testing syntax to MsTest.</Description>
    <PackageTags>F# fsharp MsTest FsUnit</PackageTags>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup Condition="($(DesignTimeBuild) == true)">
    <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="..\Common.fs">
      <Link>Common.fs</Link>
    </Compile>
    <Compile Include="..\FsUnit.Xunit\CustomMatchers.fs">
      <Link>CustomMatchers.fs</Link>
    </Compile>
    <Compile Include="FsUnit.fs" />
    <None Include="../../docs/img/logo.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="NHamcrest" />
  </ItemGroup>
</Project>